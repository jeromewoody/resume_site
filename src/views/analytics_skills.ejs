<section class="analytics-section">
  <h2 class="section-title">Skill Frequency</h2>
  <p class="analytics-subtitle">How often each skill appeared across all positions</p>
  <div id="skill-frequency-chart"></div>
</section>

<section class="analytics-section">
  <h2 class="section-title">Career Phases</h2>
  <p class="analytics-subtitle">Dominant skills in each career phase</p>
  <div id="career-phases-chart"></div>
</section>

<script src="https://cdn.jsdelivr.net/npm/d3@7"></script>
<script>
(function() {
  var cs = getComputedStyle(document.documentElement);
  window.__themeTokens = {
    chart: [
      cs.getPropertyValue('--chart-1').trim(),
      cs.getPropertyValue('--chart-2').trim(),
      cs.getPropertyValue('--chart-3').trim(),
      cs.getPropertyValue('--chart-4').trim(),
      cs.getPropertyValue('--chart-5').trim(),
      cs.getPropertyValue('--chart-6').trim()
    ],
    text1: cs.getPropertyValue('--text-1').trim(),
    text2: cs.getPropertyValue('--text-2').trim(),
    text3: cs.getPropertyValue('--text-3').trim(),
    border: cs.getPropertyValue('--border').trim(),
    nightOpacity: cs.getPropertyValue('--chart-opacity').trim() || '1'
  };
})();

// ============================================================
// Skill Frequency — Horizontal Bar Chart
// ============================================================
(function() {
  var data = <%- JSON.stringify(skill_frequency) %>;
  var tokens = window.__themeTokens;
  var container = document.getElementById('skill-frequency-chart');
  var margin = { top: 20, right: 60, bottom: 30, left: 120 };
  var width = Math.min(container.parentElement.clientWidth - 40, 900) - margin.left - margin.right;
  var barHeight = 28;
  var height = data.length * barHeight;

  var svg = d3.select('#skill-frequency-chart')
    .append('svg')
    .attr('viewBox', '0 0 ' + (width + margin.left + margin.right) + ' ' + (height + margin.top + margin.bottom))
    .attr('width', '100%')
    .attr('height', '100%')
    .append('g')
    .attr('transform', 'translate(' + margin.left + ',' + margin.top + ')');

  var x = d3.scaleLinear()
    .domain([0, d3.max(data, function(d) { return d.count; })])
    .range([0, width]);

  var y = d3.scaleBand()
    .domain(data.map(function(d) { return d.skill_name; }))
    .range([0, height])
    .padding(0.2);

  var color = d3.scaleOrdinal()
    .domain(data.map(function(d) { return d.skill_name; }))
    .range(tokens.chart);

  // X axis
  svg.append('g')
    .attr('transform', 'translate(0,' + height + ')')
    .call(d3.axisBottom(x).ticks(5))
    .attr('class', 'd3-axis');

  // Y axis
  svg.append('g')
    .call(d3.axisLeft(y).tickSize(0))
    .select('.domain').remove()
    .attr('class', 'd3-axis d3-axis-y');

  svg.selectAll('.d3-axis-y text')
    .style('font-size', '0.8rem')
    .style('fill', tokens.text2);

  // Bars
  var bars = svg.selectAll('.bar')
    .data(data)
    .enter()
    .append('rect')
    .attr('class', 'd3-bar')
    .attr('y', function(d) { return y(d.skill_name); })
    .attr('height', y.bandwidth())
    .attr('x', 0)
    .attr('width', 0)
    .attr('fill', function(d) { return color(d.skill_name); })
    .style('cursor', 'pointer')
    .style('opacity', tokens.nightOpacity);

  // Tooltips
  var tooltip = d3.select('#skill-frequency-chart')
    .append('div')
    .attr('class', 'd3-tooltip')
    .style('opacity', 0);

  bars.on('mouseover', function(event, d) {
    tooltip
      .style('opacity', 1)
      .html('<strong>' + d.skill_name + '</strong><br>Used in ' + d.count + ' position' + (d.count !== 1 ? 's' : ''));
    d3.select(this).attr('opacity', 0.7);
  })
  .on('mousemove', function(event) {
    tooltip
      .style('left', (event.pageX + 12) + 'px')
      .style('top', (event.pageY - 12) + 'px');
  })
  .on('mouseout', function() {
    tooltip.style('opacity', 0);
    d3.select(this).attr('opacity', 1);
  });

  // Animate bars
  bars.transition()
    .duration(600)
    .attr('width', function(d) { return x(d.count); })
    .attr('rx', 2);

  // Value labels
  svg.selectAll('.bar-label')
    .data(data)
    .enter()
    .append('text')
    .attr('class', 'd3-bar-label')
    .attr('x', function(d) { return x(d.count) + 4; })
    .attr('y', function(d) { return y(d.skill_name) + y.bandwidth() / 2 + 4; })
    .text(function(d) { return d.count; })
    .style('font-size', '0.75rem')
    .style('fill', tokens.text2);
})();

// ============================================================
// Career Phases — Grouped Mini Bar Charts
// ============================================================
(function() {
  var phases = <%- JSON.stringify(career_phases) %>;
  var tokens = window.__themeTokens;
  var container = document.getElementById('career-phases-chart');

  var phaseWidth = 220;
  var phaseGap = 30;
  var totalWidth = phases.length * (phaseWidth + phaseGap);
  var height = 320;
  var margin = { top: 40, right: 20, bottom: 20, left: 20 };

  var svg = d3.select('#career-phases-chart')
    .append('svg')
    .attr('viewBox', '0 0 ' + (totalWidth + margin.left + margin.right) + ' ' + (height + margin.top + margin.bottom))
    .attr('width', '100%')
    .attr('height', '100%')
    .append('g')
    .attr('transform', 'translate(' + margin.left + ',' + margin.top + ')');

  var color = d3.scaleOrdinal().range(tokens.chart);

  phases.forEach(function(phase, i) {
    var g = svg.append('g')
      .attr('transform', 'translate(' + (i * (phaseWidth + phaseGap)) + ',0)');

    // Phase label
    g.append('text')
      .attr('x', phaseWidth / 2)
      .attr('y', -18)
      .attr('text-anchor', 'middle')
      .style('font-size', '0.9rem')
      .style('font-weight', '600')
      .style('fill', tokens.text1)
      .text(phase.phase_name);

    // Bars
    var maxCount = d3.max(phase.dominant_skills, function(d) { return d.count; });
    var x = d3.scaleLinear().domain([0, maxCount]).range([0, phaseWidth]);
    var barH = 18;
    var gap = 4;

    phase.dominant_skills.forEach(function(skill, j) {
      var y = j * (barH + gap);
      g.append('rect')
        .attr('x', 0)
        .attr('y', y)
        .attr('width', x(skill.count))
        .attr('height', barH)
        .attr('rx', 2)
        .attr('fill', color(skill.skill_name))
        .attr('opacity', 0.85 * parseFloat(tokens.nightOpacity));

      g.append('text')
        .attr('x', x(skill.count) + 4)
        .attr('y', y + barH / 2 + 4)
        .style('font-size', '0.7rem')
        .style('fill', tokens.text2)
        .text(skill.skill_name);
    });

    // Position count
    g.append('text')
      .attr('x', phaseWidth / 2)
      .attr('y', phase.dominant_skills.length * (barH + gap) + 8)
      .attr('text-anchor', 'middle')
      .style('font-size', '0.75rem')
      .style('fill', tokens.text3)
      .text(phase.positions.length + ' position' + (phase.positions.length !== 1 ? 's' : ''));
  });
})();
</script>