<header class="resume-header">
  <div class="hatman-watermark" id="hatman-watermark" aria-hidden="true"></div>
  <div class="hero-main">
    <div class="header-row">
      <div class="hatman-avatar" id="hatman-avatar">
        <img src="<%= BASE %>/images/hat-nyc-blue.png" alt="Jerome Woody" id="hatman-img">
      </div>
      <div class="hero-id">
        <h1 class="person-name"><%= contact_info.name %></h1>
        <div class="person-role">Web | Mobile | ML Ops</div>
      </div>
    </div>
    <div class="contact-info">
      <a class="contact-link" href="mailto:<%= contact_info.email %>"><%= contact_info.email %></a>
      <a class="contact-link" href="tel:<%= contact_info.phone.replace(/\D/g, '') %>"><%= contact_info.phone %></a>
    </div>
    <% if (typeof stats !== 'undefined' && stats) { %>
    <div class="hero-stats" role="list" aria-label="Career at a glance">
      <span class="stat-chip" role="listitem"><strong><%= stats.years %></strong>&nbsp;yrs</span>
      <span class="stat-chip" role="listitem"><strong><%= stats.positions %></strong>&nbsp;roles</span>
      <span class="stat-chip" role="listitem"><strong><%= stats.skills %></strong>&nbsp;skills</span>
    </div>
    <% } %>
  </div>
  <div class="hero-side">
    <nav class="analytics-nav" aria-label="Site sections">
      <a href="<%= BASE %>/">Resume</a>
      <a href="<%= BASE %>/analytics/distribution">Analytics Dashboard</a>
    </nav>
    <button class="theme-toggle" id="theme-toggle" aria-label="Cycle theme">
      <span class="theme-toggle-icon" id="theme-icon">☀️</span>
      <span id="theme-label">Morning</span>
    </button>
  </div>
</header>
<script>
  // HatMan icon: swap color based on theme
  var hatmanIcons = {
    porcelain: '<%= BASE %>/images/hat-nyc-blue.png',
    editorial: '<%= BASE %>/images/hat-nyc-orange.png',
    'slate-noir': '<%= BASE %>/images/hat-nyc-navy.png'
  };

  function updateHatmanIcon(theme) {
    var img = document.getElementById('hatman-img');
    if (img && hatmanIcons[theme]) {
      img.src = hatmanIcons[theme];
    }
  }

  // ============================================================
  // themeManager: time-based theme that re-evaluates live.
  //   - Time-based theme is the default (porcelain 05–12, editorial
  //     12–17, slate-noir otherwise).
  //   - A manual click sets an in-memory override for this page
  //     session; it is NOT persisted (so it never silently defeats
  //     the time-based theme on the next visit).
  //   - When the time period actually changes, the override is
  //     dropped and the time-based theme is applied automatically.
  // ============================================================
  (function() {
    var themes = ['porcelain', 'editorial', 'slate-noir'];
    var labels = { porcelain: 'Morning', editorial: 'Afternoon', 'slate-noir': 'Evening' };
    var icons  = { porcelain: '☀️', editorial: '🌤', 'slate-noir': '🌙' };
    var btn = document.getElementById('theme-toggle');
    var iconEl = document.getElementById('theme-icon');
    var labelEl = document.getElementById('theme-label');

    if (!btn) return;

    function computeTimeTheme() {
      var hour = new Date().getHours();
      if (hour >= 5 && hour < 12) return 'porcelain';
      if (hour >= 12 && hour < 17) return 'editorial';
      return 'slate-noir';
    }

    // manual override lives only in this variable (page-session scope)
    var override = null;
    // remember which time-based theme was last applied, so we only
    // react when the period actually changes
    var lastTimeTheme = computeTimeTheme();

    function apply(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.style.colorScheme =
        (theme === 'slate-noir') ? 'dark' : 'light';
      if (iconEl) iconEl.textContent = icons[theme];
      if (labelEl) labelEl.textContent = labels[theme];
      updateHatmanIcon(theme);
    }

    function activeTheme() {
      return override || computeTimeTheme();
    }

    // Poll cheaply: only act when the time-based period changes.
    function tick() {
      var t = computeTimeTheme();
      if (t !== lastTimeTheme) {
        // A new time period started — drop any manual override so the
        // visitor always ends up on the time-appropriate theme.
        lastTimeTheme = t;
        override = null;
        apply(t);
      }
    }

    btn.addEventListener('click', function() {
      var next = themes[(themes.indexOf(activeTheme()) + 1) % themes.length];
      override = next;           // in-memory only; survives until period change
      apply(next);
    });

    // Initialize to the time-based theme (matches the head IIFE).
    apply(computeTimeTheme());

    // Re-evaluate once a minute; also run on visibility return so a
    // tab that was backgrounded across a boundary corrects immediately.
    setInterval(tick, 60000);
    document.addEventListener('visibilitychange', function() {
      if (!document.hidden) tick();
    });
    window.addEventListener('focus', tick);
  })();
</script>
