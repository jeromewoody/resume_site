<%
  var posId = position.$.position_id;
  var companyFk = position.$.company_fk;
  var staffingFk = position.$.staffing_fk;
  var skillsFk = position.$.skills_fk;

  var titleObj = position.position_title;
  if (Array.isArray(titleObj)) { titleObj = titleObj[0]; }
  var posType = titleObj.$ ? titleObj.$.position_type : 'full_time';
  var posTitle = titleObj._ || '';

  var dateStarted = position.date_started;
  if (Array.isArray(dateStarted)) { dateStarted = dateStarted[0]; }
  var dateEnded = position.date_ended;
  if (dateEnded) {
    if (Array.isArray(dateEnded)) { dateEnded = dateEnded[0]; }
  }

  var skills = getSkillsForPosition(skillsFk);
  var companyName = getCompanyName(companyFk);
  var staffingName = getStaffingName(staffingFk);
%>

<article id="card-<%= posId %>" class="position-card position-card--expanded">
  <div class="position-content">
    <header class="position-header">
      <h3 class="position-title"><%= posTitle %></h3>
      <div class="position-company">
        <span class="company-name"><%= companyName %></span>
        <% if (staffingName) { %>
          <span class="staffing-separator">via</span>
          <span class="staffing-name"><%= staffingName %></span>
        <% } %>
      </div>
    </header>

    <div class="employment-details">
      <div class="duration">
        <span class="duration-label">Duration: </span>
        <span class="date-range">
          <time class="date-start"><%= formatDate(dateStarted) %></time>
          <span class="date-separator"> – </span>
          <time class="date-end"><%= dateEnded ? formatDate(dateEnded) : 'Present' %></time>
        </span>
      </div>
      <div class="employment-type">
        <span class="type-label">Employment Type: </span>
        <span class="type-value"><%= formatType(posType) %></span>
      </div>
    </div>

    <% if (skills && skills.length > 0) { %>
    <div class="skills-section">
      <h4 class="skills-title">Technologies &amp; Skills</h4>
      <div class="skills-list">
        <% skills.forEach(function(s) { %>
          <a class="skill-tag" href="/skill/<%= s.skill_id %>"><%= s.skill_value %></a>
        <% }) %>
      </div>
    </div>
    <% } %>

    <% if (position.summary_items && position.summary_items.length > 0) { %>
    <div class="summary-section">
      <h4 class="summary-title">Key Responsibilities &amp; Achievements</h4>
      <ul class="summary-list">
        <% position.summary_items.forEach(function(item) { %>
          <li class="summary-item"><%= item %></li>
        <% }) %>
      </ul>
    </div>
    <% } %>
  </div>
</article>
