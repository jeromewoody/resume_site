<%
  // Expanded timeline row (same anatomy as the collapsed row + bullets).
  var _isCurrent = (typeof isCurrent === 'undefined')
    ? (dateEnded === undefined || dateEnded === null || dateEnded === 'Present')
    : isCurrent;
  var _isLatest = (typeof isLatest === 'undefined') ? false : isLatest;
%>
<article id="card-<%= posId %>" class="tl-entry is-expanded<% if (_isCurrent) { %> is-current<% } else if (_isLatest) { %> is-latest<% } %>">
  <span class="tl-dot" aria-hidden="true"></span>
  <div class="tl-row">
    <header class="tl-head">
      <h3 class="position-title"><%= posTitle %></h3>
      <div class="tl-meta">
        <span class="company-name"><%= companyName %></span>
        <% if (staffingName) { %>
          <span class="staffing-separator">via <%= staffingName %></span>
        <% } %>
        <span class="tl-sep" aria-hidden="true">·</span>
        <time class="date-start"><%= formatDate(dateStarted) %></time>
        <span class="date-separator">–</span>
        <time class="date-end"><%= dateEnded ? formatDate(dateEnded) : 'Present' %></time>
        <span class="type-value <%= positionType %>"><%= formatType(positionType) %></span>
        <% if (_isCurrent) { %>
          <span class="tl-flag tl-flag--current">Current</span>
        <% } else if (_isLatest) { %>
          <span class="tl-flag tl-flag--latest">Most recent</span>
        <% } %>
      </div>
    </header>

    <% if (skills && skills.length > 0) { %>
    <div class="skills-list">
      <% skills.forEach(function(s) { %>
        <button class="skill-tag"
                hx-get="<%= BASE %>/api/positions/by-skill/<%= s.skill_id %>"
                hx-target="#results"
                hx-swap="outerHTML"
                aria-label="Filter by <%= s.skill_value %>">
          <%= s.skill_value %>
        </button>
      <% }) %>
    </div>
    <% } %>

    <% if (summaryItems && summaryItems.length > 0) { %>
    <ul class="summary-list">
      <% summaryItems.forEach(function(item) { %>
        <li class="summary-item"><%= item %></li>
      <% }) %>
    </ul>
    <% } %>

    <button class="tl-toggle"
            hx-get="<%= BASE %>/api/position/<%= posId %>/summary"
            hx-target="#card-<%= posId %>"
            hx-swap="outerHTML"
            aria-expanded="true"
            aria-label="Hide highlights for <%= posTitle %>">
      <span class="tl-toggle-icon" aria-hidden="true">▾</span>
      Show less
    </button>
  </div>
</article>
