<% var isCurrent = dateEnded === undefined || dateEnded === null || dateEnded === 'Present'; %>
<article id="card-<%= posId %>" class="position-card position-card--expanded<% if (isCurrent) { %> is-current<% } %>">
  <div class="position-content">
    <header class="position-header">
      <h3 class="position-title"><%= escapeHtml(posTitle) %></h3>
      <div class="position-company">
        <span class="company-name"><%= escapeHtml(companyName) %></span>
        <% if (staffingName) { %>
          <span class="staffing-separator">via</span>
          <span class="staffing-name"><%= escapeHtml(staffingName) %></span>
        <% } %>
      </div>
    </header>

    <div class="employment-details">
      <div class="duration">
        <span class="duration-label">Duration: </span>
        <span class="date-range">
          <time class="date-start"><%= formatDate(dateStarted) %></time>
          <span class="date-separator"> – </span>
          <time class="date-end"><%= dateEnded ? formatDate(dateEnded) : 'Present' %></time>
        </span>
      </div>
      <div class="employment-type">
        <span class="type-value <%= positionType %>"><%= formatType(positionType) %></span>
      </div>
    </div>

    <% if (skills && skills.length > 0) { %>
    <div class="skills-section">
      <h4 class="skills-title">Technologies &amp; Skills</h4>
      <div class="skills-list">
        <% skills.forEach(function(s) { %>
          <button class="skill-tag"
                  hx-get="/api/positions/by-skill/<%= s.skill_id %>"
                  hx-target="#results"
                  hx-swap="outerHTML"
                  aria-label="Filter by <%= escapeHtml(s.skill_value) %>">
            <%= escapeHtml(s.skill_value) %>
          </button>
        <% }) %>
      </div>
    </div>
    <% } %>

    <% if (summaryItems && summaryItems.length > 0) { %>
    <div class="summary-section">
      <h4 class="summary-title">Key Responsibilities &amp; Achievements</h4>
      <ul class="summary-list">
        <% summaryItems.forEach(function(item) { %>
          <li class="summary-item"><%= escapeHtml(item) %></li>
        <% }) %>
      </ul>
    </div>
    <% } %>

    <div class="position-details-toggle">
      <button class="details-link details-link--collapse"
              hx-get="/api/position/<%= posId %>/summary"
              hx-target="#card-<%= posId %>"
              hx-swap="outerHTML"
              aria-label="Show less details for <%= escapeHtml(posTitle) %>">
        &uarr; Show Less
      </button>
    </div>
  </div>
</article>