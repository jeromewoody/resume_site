<%
  // Timeline helpers (server-side; the list arrives newest-first).
  var _now = new Date();
  var _nowYm = _now.getFullYear() * 100 + (_now.getMonth() + 1);
  function _ym(d) {
    if (!d || !d.$) return null;
    return parseInt(d.$.year, 10) * 100 + parseInt(d.$.month, 10);
  }
  // id of the most recently ended (or open) position — gets the "Most recent" node
  var _latestId = null;
  var _maxEndYm = null;
  (positions || []).forEach(function(p) {
    var ey = _ym(p.date_ended);
    if (ey === null) ey = _nowYm;               // open-ended = today
    if (_maxEndYm === null || ey > _maxEndYm) { _maxEndYm = ey; _latestId = p.$.position_id; }
  });
  var _lastYear = null;
%>
<div id="results" class="timeline">
  <% if (positions && positions.length > 0) { %>
    <p class="results-count"><%= positions.length %> position<%= positions.length === 1 ? '' : 's' %></p>
    <% positions.forEach(function(pos) {
      // Extract position data
      var posId = pos.$.position_id;
      var companyFk = pos.$.company_fk;
      var staffingFk = pos.$.staffing_fk;
      var skillsFk = pos.$.skills_fk;

      // Handle position_title — can be object or array
      var titleObj = pos.position_title;
      if (Array.isArray(titleObj)) { titleObj = titleObj[0]; }
      var posType = titleObj.$ ? titleObj.$.position_type : 'full_time';
      var posTitle = titleObj._ || '';

      // Handle dates
      var dateStarted = pos.date_started;
      if (Array.isArray(dateStarted)) { dateStarted = dateStarted[0]; }
      var dateEnded = pos.date_ended;
      if (dateEnded) {
        if (Array.isArray(dateEnded)) { dateEnded = dateEnded[0]; }
      }

      // Get skills array
      var skills = getSkillsForPosition(skillsFk);

      // Get company & staffing names
      var companyName = getCompanyName(companyFk);
      var staffingName = getStaffingName(staffingFk);

      // Timeline state
      var startYm = _ym(dateStarted);
      var startY = startYm !== null ? Math.floor(startYm / 100) : null;
      var endYm = _ym(dateEnded);
      var isCurrent = endYm === null || endYm >= _nowYm;
      var isLatest = posId === _latestId;
      var showYear = startY !== null && startY !== _lastYear;
      if (showYear) _lastYear = startY;
    %>
      <% if (showYear) { %><div class="tl-year"><span><%= startY %></span></div><% } %>
      <%- include('position_card', {
        posId: posId,
        posTitle: posTitle,
        companyName: companyName,
        staffingName: staffingName,
        dateStarted: dateStarted,
        dateEnded: dateEnded,
        positionType: posType,
        skills: skills,
        summaryItems: pos.summary_items,
        isCurrent: isCurrent,
        isLatest: isLatest
      }) %>
    <% }) %>
  <% } else { %>
    <div class="resume-empty">
      <p class="empty-text">
        <span class="empty-icon">🔍</span>
        No positions match the selected filters.
      </p>
    </div>
  <% } %>
</div>
