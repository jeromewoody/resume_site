<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Resume of Jerome Woody — Senior Frontend Engineer with 20+ years of experience in web development, React, and mobile applications.">
  <meta name="theme-color" content="#4f46e5">
  <meta property="og:title" content="<%= title || 'Jerome Woody — Resume' %>">
  <meta property="og:description" content="Senior Frontend Engineer with 20+ years of experience.">
  <link rel="icon" type="image/png" href="/images/hat-nyc-blue.png">
  <title><%= title || 'Jerome Woody — Resume' %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.4/dist/htmx.min.js"></script>
  <script>
    // ============================================================
    // Time-based theme detection (runs before CSS loads — zero FOUC)
    // The live re-evaluation loop (themeManager) lives in header.ejs,
    // where DOM is available. This head IIFE only applies the initial
    // theme synchronously so the first paint is correct.
    // ============================================================
    (function() {
      var hour = new Date().getHours();
      var theme = 'porcelain';
      if (hour >= 5 && hour < 12) theme = 'porcelain';
      else if (hour >= 12 && hour < 17) theme = 'editorial';
      else theme = 'slate-noir';

      // Manual override is intentionally in-memory only (set by themeManager
      // on click); it is NOT persisted to localStorage, so the next time
      // period reverts to the time-based default. No read here.

      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.style.colorScheme =
        (theme === 'slate-noir') ? 'dark' : 'light';
    })();
  </script>
  <script>
    // night-mode class needs <body> to exist, so defer to DOMContentLoaded.
    // (Previously this ran in the head IIFE where document.body was null.)
    (function() {
      function applyNight() {
        var h = new Date().getHours();
        if (h >= 22 || h < 5) document.body.classList.add('night-mode');
        else document.body.classList.remove('night-mode');
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applyNight);
      } else {
        applyNight();
      }
    })();
  </script>
  <script>
    // Year range slider: prevent crossing, update fill, update labels.
    // NOTE: this script sits in <head>, so element lookups must be deferred
    // to DOMContentLoaded — grabbing them at parse time found nothing and
    // silently disabled the whole widget.
    (function() {
      var fromSlider, toSlider, fill, fromLabel, toLabel, rangeLabel, form;

      function init() {
        fromSlider = document.getElementById('year-from');
        toSlider = document.getElementById('year-to');
        fill = document.querySelector('.year-slider-fill');
        fromLabel = document.querySelector('.year-from-label');
        toLabel = document.querySelector('.year-to-label');
        rangeLabel = document.querySelector('.year-range-label');
        form = document.getElementById('filter-form');

      function updateSliderValues() {
        var fromVal = parseInt(fromSlider.value);
        var toVal = parseInt(toSlider.value);

        if (fromVal > toVal) {
          toSlider.value = fromVal;
          fromLabel.textContent = fromVal;
          toLabel.textContent = fromVal;
          rangeLabel.textContent = '– ' + fromVal;
          updateFill();
          return;
        }
        if (toVal < fromVal) {
          fromSlider.value = toVal;
          fromLabel.textContent = toVal;
          toLabel.textContent = toVal;
          rangeLabel.textContent = toVal + ' –';
          updateFill();
          return;
        }

        fromLabel.textContent = fromVal;
        toLabel.textContent = toVal;
        rangeLabel.textContent = fromVal + ' – ' + toVal;
        updateFill();
      }

      function updateFill() {
        var fromVal = parseInt(fromSlider.value);
        var toVal = parseInt(toSlider.value);
        var minVal = parseInt(fromSlider.min);
        var maxVal = parseInt(fromSlider.max);
        var fromPct = ((fromVal - minVal) / (maxVal - minVal)) * 100;
        var toPct = ((toVal - minVal) / (maxVal - minVal)) * 100;
        fill.style.left = fromPct + '%';
        fill.style.width = (toPct - fromPct) + '%';
      }

      if (!fromSlider || !toSlider) return;
      fromSlider.addEventListener('input', function() {
        updateSliderValues();
        if (form) form.dispatchEvent(new Event('change', { bubbles: true }));
      });
      toSlider.addEventListener('input', function() {
        updateSliderValues();
        if (form) form.dispatchEvent(new Event('change', { bubbles: true }));
      });
      updateSliderValues();

      // Clear Filters: reset every control (sliders return to their default
      // value attrs = full range), repaint, then re-run the filter. The
      // button itself must NOT carry hx-post — it would serialize the
      // still-moved sliders and re-apply the year filter.
      var clearBtn = document.getElementById('clear-filters-btn');
      if (clearBtn && form) {
        clearBtn.addEventListener('click', function() {
          form.reset();
          updateSliderValues();
          form.dispatchEvent(new Event('change', { bubbles: true }));
        });
      }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
</head>
<body>
   <div class="resume-container">
     <%- include('header', { contact_info: contact_info }) %>
     <%- body %>
     <footer class="site-footer">
       <span class="footer-copy">© <%= new Date().getFullYear() %> Jerome Woody · Built with Node, EJS &amp; HTMX</span>
       <% if (typeof xmlValid !== 'undefined' && xmlValid === true) { %>
         <span class="xml-badge xml-badge--ok" title="resume.xml validated against resume.dtd with xmllint at server start">XML · DTD valid</span>
       <% } else if (typeof xmlValid !== 'undefined' && xmlValid === false) { %>
         <span class="xml-badge xml-badge--fail" title="xmllint reported DTD validity errors — run npm run validate-xml">DTD issues</span>
       <% } else { %>
         <span class="xml-badge xml-badge--na" title="xmllint not installed — validation skipped at server start">XML · not checked</span>
       <% } %>
     </footer>
     <script>
       // Highlight nav button for the current page
       (function() {
         var loc = window.location.pathname;
         document.querySelectorAll('.analytics-nav a').forEach(function(a) {
           var href = a.getAttribute('href');
           a.classList.toggle('current-nav', href === '/' ? loc === '/' : href === loc);
         });
       })();
     </script>
   </div>
</body>
</html>